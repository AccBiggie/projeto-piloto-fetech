# Modelo do .env de PRODUÇÃO. Na VPS: copie para /opt/fetech/.env e preencha.
# Nunca versione o .env de verdade.

# Domínio do site (sem https://). O deploy registra este domínio no Caddy, que emite o HTTPS.
APP_DOMAIN=
APP_URL=https://seu-dominio.com.br

APP_NAME=Fetech
APP_ENV=production
# Gere com:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fetech
DB_USERNAME=fetech
# Gere as senhas com:  openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Requisições por IP (web e api por minuto; contato por minuto e por dia)
RATE_LIMIT_WEB=300
RATE_LIMIT_API=60
RATE_LIMIT_CONTACT_MINUTE=3
RATE_LIMIT_CONTACT_DAY=20

# E-mail do formulário de contato (SMTP do provedor)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Fetech
MAIL_CONTACT_TO=
