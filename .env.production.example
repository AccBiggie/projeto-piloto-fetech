# Modelo do .env de PRODUÇÃO. Na VPS: copie para /opt/fetech/.env e preencha.
# Nunca versione o .env de verdade.

# Domínio do site (sem https://). O deploy registra este domínio no Caddy, que emite o HTTPS;
# começando com "www.", o domínio sem "www" redireciona para ele.
APP_DOMAIN=www.fetech.systems
# Base de canonical, Open Graph, JSON-LD e sitemap: o domínio canônico, sem barra final
APP_URL=https://www.fetech.systems

APP_NAME=Fetech
# Fora de production o robots.txt bloqueia tudo e as páginas saem com noindex
APP_ENV=production
# Gere com:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fetech
DB_USERNAME=fetech
# Gere as senhas com:  openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Requisições por IP (web e api por minuto; contato por minuto e por dia)
RATE_LIMIT_WEB=300
RATE_LIMIT_API=60
RATE_LIMIT_CONTACT_MINUTE=3
RATE_LIMIT_CONTACT_DAY=20

# E-mail do formulário de contato (SMTP do provedor)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Fetech
MAIL_CONTACT_TO=

# Painel de clientes (/painel): estatísticas lidas dos logs JSON do Caddy pelo serviço "scheduler".
# CADDY_LOG_DIR é a pasta do host onde o Caddy grava os logs (montada só leitura em /var/log/caddy);
# CADDY_ACCESS_LOGS são os arquivos dentro do container, separados por vírgula.
CADDY_LOG_DIR=/opt/caddy-logs
CADDY_ACCESS_LOGS=/var/log/caddy/access.log
PAINEL_RETENTION_DAYS=400
