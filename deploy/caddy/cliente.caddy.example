# Modelo do site de um cliente. Copie para /opt/caddy-sites/<projeto>.caddy, troque os domínios e o nome
# do serviço e recarregue o Caddy:
#   docker exec wedding-caddy-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
#
# <projeto> é a pasta do cliente em /opt/clientes (o mesmo nome cadastrado no campo "Projeto" do painel),
# com o docker-compose.yml dele. O serviço web do cliente entra na rede "proxy" com um alias único.
cliente.com.br, www.cliente.com.br {
	# Primeiro: página de suspensão quando o cliente está bloqueado no painel
	import suspensao

	# Log de acesso em JSON para as estatísticas do painel (painel:importar-acessos). Todos os sites gravam
	# no mesmo arquivo com este bloco idêntico (vale o do primeiro site carregado); mode 0644 (Caddy 2.9+)
	# deixa o container do Fetech ler. roll_keep_for 4392h: 6 meses de registros (Marco Civil, art. 15).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 30
			roll_keep_for 4392h
			roll_uncompressed
			mode 0644
		}
		format json
	}

	encode zstd gzip
	reverse_proxy cliente-web:80
}
