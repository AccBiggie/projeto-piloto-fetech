# Site do Fetech no Caddy da VPS. O deploy troca __DOMAIN__ pelo APP_DOMAIN do .env
# e grava o resultado em /opt/caddy-sites/fetech.caddy, importado pelo Caddyfile principal.
# __APEX_DOMAIN__ é o mesmo domínio sem o "www."; sem "www." no APP_DOMAIN, o bloco do apex é removido.
# CSP e demais headers de segurança vêm do Laravel e do Nginx.
__DOMAIN__ {
	# Log de acesso em JSON para as estatísticas do painel (painel:importar-acessos). Todos os sites gravam
	# no mesmo arquivo com a mesma configuração; mode 0644 (Caddy 2.9+) deixa o container do Fetech ler.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_uncompressed
			mode 0644
		}
		format json
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy fetech-web:80
}

# apex:inicio
# Um domínio só para os buscadores: o endereço sem "www" redireciona (301) para o canônico
__APEX_DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
# apex:fim
