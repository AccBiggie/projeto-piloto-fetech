APP_NAME=Fetech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3001

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=test_db
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Requisições por IP (web e api por minuto; contato por minuto e por dia)
RATE_LIMIT_WEB=300
RATE_LIMIT_API=60
RATE_LIMIT_CONTACT_MINUTE=3
RATE_LIMIT_CONTACT_DAY=20

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@fetech.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_TO="contato@fetech.local"

VITE_APP_NAME="${APP_NAME}"
